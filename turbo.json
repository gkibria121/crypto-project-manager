{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "API_PORT",
    "WEB_PORT",
    "SCRAPER_PORT",
    "DATABASE_URL",
    "API_INTERNAL_URL",
    "SCRAPER_SERVICE_URL",
    "SCRAPER_API_KEY",
    "SCRAPER_TIMEOUT_MS",
    "CORS_ORIGINS",
    "JWT_SECRET",
    "SESSION_TTL_SECONDS",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "COINGECKO_API_KEY",
    "COINMARKETCAP_API_KEY",
    "LIVECOINWATCH_API_KEY",
    "COINCAP_API_KEY"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:update": {
      "cache": false
    },
    "db:verify": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "src/prisma/contract.json",
        "src/prisma/contract.d.ts"
      ]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "^db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "^db:generate"]
    },
    "clean": {
      "cache": false
    }
  }
}
