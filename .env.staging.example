# Domains & Traefik Routing (external Traefik on app-network)
WEB_DOMAIN=crypto.gkibria121.com
API_DOMAIN=api-crypto.gkibria121.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS_ENABLE=true
TRAEFIK_CERT_RESOLVER=le

# PostgreSQL
POSTGRES_USER=pulseos
POSTGRES_PASSWORD=change_me_staging_password
POSTGRES_DB=pulseos

# NestJS Core Backend (apps/api)
CORS_ORIGINS=https://crypto.gkibria121.com,https://api-crypto.gkibria121.com
SCRAPER_API_KEY=change_me_internal_scraper_key
SCRAPER_TIMEOUT_MS=60000
JWT_SECRET=change_me_to_a_long_random_jwt_secret_in_staging
SESSION_TTL_SECONDS=604800

# Optional AI Provider API Keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional Scraper, Market Cap Sync & Lead Enrichment Keys
X_API_BEARER_TOKEN=
LINKEDIN_API_KEY=
TELEGRAM_BOT_TOKEN=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
LIVECOINWATCH_API_KEY=
COINCAP_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
SNOV_API_KEY=
LUSHA_API_KEY=

# Python Scraper Microservice
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_CONTENT_BYTES=3145728
ALLOW_PRIVATE_NETWORKS=false
