{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "prisma contract emit && tsc -p tsconfig.json && mkdir -p dist/src/prisma && cp src/prisma/contract.json src/prisma/contract.d.ts dist/src/prisma/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma contract emit",
    "db:migrate": "prisma migration plan",
    "db:migrate:deploy": "prisma db migrate",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "db:seed": "bun prisma/seed.ts",
    "db:seed:prod": "node dist/prisma/seed.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "pg": "^8.22.0",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.4",
    "prisma": "8.0.0-rc.33",
    "typescript": "^5.9.3"
  }
}
