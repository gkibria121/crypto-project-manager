// use prisma-8

model mixin Timestamps {
  createdAt DateTime @default(now()) @onCreate(now()) @map("created_at")
  updatedAt DateTime @default(now()) @onCreate(now()) @onUpdate(now()) @map("updated_at")
}

enum ContextType {
  @@type("pg/text@1")
  website  = "website"
  x_handle = "x_handle"
  linkedin = "linkedin"
  telegram = "telegram"
  message  = "message"
}

enum ProjectStage {
  @@type("pg/text@1")
  PRE_TGE          = "Pre-TGE"
  MAINNET_LIVE     = "Mainnet Live"
  IDO_LAUNCHPAD    = "IDO / Launchpad"
  ECOSYSTEM_GROWTH = "Ecosystem Growth"
  STEALTH          = "Stealth"
}

enum ProjectBusinessStatus {
  @@type("pg/text@1")
  new          = "new"
  active       = "active"
  contacted    = "contacted"
  collaborated = "collaborated"
  completed    = "completed"
  unresponsive = "unresponsive"
  archived     = "archived"
}

enum MessageSender {
  @@type("pg/text@1")
  admin = "admin"
  ai    = "ai"
}

enum ScrapeStatus {
  @@type("pg/text@1")
  pending          = "pending"
  running          = "running"
  completed        = "completed"
  unreachable      = "unreachable"
  failed           = "failed"
  api_key_required = "api_key_required"
}

enum UserRole {
  @@type("pg/text@1")
  admin   = "admin"
  manager = "manager"
  analyst = "analyst"
  viewer  = "viewer"
}

model User {
  id           String    @id @onCreate(cuid(2))
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         UserRole  @default(analyst)
  title        String    @default("Growth Analyst")
  avatarColor  String    @default("bg-[#1d4ed8]") @map("avatar_color")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  +Timestamps

  sessions AuthSession[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model AuthSession {
  id        String    @id @onCreate(cuid(2))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @onCreate(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id         String   @id @onCreate(cuid(2))
  actorId    String?  @map("actor_id")
  actorEmail String   @map("actor_email")
  actorRole  UserRole @map("actor_role")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @onCreate(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resource, createdAt])
  @@map("audit_logs")
}

model Project {
  id               String                @id
  name             String
  ticker           String
  chain            String
  stage            ProjectStage
  businessStatus   ProjectBusinessStatus @default(new) @map("business_status")
  avatarBg         String                @map("avatar_bg")
  logoUrl          String?               @map("logo_url")
  tagline          String                @default("")
  campaignBudget   String                @default("$25,000 / mo") @map("campaign_budget")
  sentimentScore   Int                   @default(90) @map("sentiment_score")
  platformRanks    Json?                 @map("platform_ranks")
  tags             String[]              @default(sql`'{}'::text[]`)
  isPinned         Boolean               @default(false) @map("is_pinned")
  unreadInsights   Int                   @default(0) @map("unread_insights")
  lastActivityTime String                @default("Now") @map("last_activity_time")
  lastScrapedAt    DateTime?             @map("last_scraped_at")
  archivedAt       DateTime?             @map("archived_at")
  +Timestamps

  contexts        ProjectContext[]
  messages        ChatMessage[]
  checklistStates ProjectChecklistState[]
  scrapeJobs      ScrapeJob[]
  scrapedPages    ScrapedPage[]

  @@check(expression: sql`sentiment_score >= 0 AND sentiment_score <= 100`, name: "project_sentiment_bounds")
  @@index([businessStatus])
  @@index([businessStatus], where: sql`archived_at IS NULL`, name: "projects_active_status_idx")
  @@index([isPinned, createdAt])
  @@index([updatedAt])
  @@fullTextIndex([[name, ticker], tagline], name: "projects_search_idx")
  @@map("projects")
}

model ProjectContext {
  id              String        @id
  projectId       String        @map("project_id")
  type            ContextType
  title           String
  value           String
  url             String?
  summary         String?
  isActive        Boolean       @default(true) @map("is_active")
  updatedAtLabel  String        @default("Now") @map("updated_at_label")
  scrapeStatus    ScrapeStatus? @map("scrape_status")
  lastScrapedAt   DateTime?     @map("last_scraped_at")
  scrapedMetadata Json?         @map("scraped_metadata")
  +Timestamps

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scrapeJobs   ScrapeJob[]
  scrapedPages ScrapedPage[]

  @@index([projectId, createdAt])
  @@index([projectId, isActive])
  @@index([scrapeStatus])
  @@map("project_contexts")
}

model ChatMessage {
  id                       String        @id
  projectId                String        @map("project_id")
  sender                   MessageSender
  content                  String
  timestampLabel           String        @map("timestamp_label")
  usedContextIds           String[]      @default(sql`'{}'::text[]`) @map("used_context_ids")
  suggestedActions         String[]      @default(sql`'{}'::text[]`) @map("suggested_actions")
  appliedSystemPromptTitle String?       @map("applied_system_prompt_title")
  model                    String?
  metadata                 Json?
  createdAt                DateTime      @default(now()) @onCreate(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@fullTextIndex([content], name: "chat_messages_search_idx")
  @@map("chat_messages")
}

model PromptTemplate {
  id           String  @id
  label        String
  description  String?
  systemPrompt String  @map("system_prompt")
  isDefault    Boolean @default(false) @map("is_default")
  sortOrder    Int     @default(0) @map("sort_order")
  +Timestamps

  @@index([sortOrder])
  @@map("prompt_templates")
}

model ChecklistItem {
  id         String  @id
  label      String
  category   String  @default("general")
  scanPrompt String  @map("scan_prompt")
  isRequired Boolean @default(false) @map("is_required")
  sortOrder  Int     @default(0) @map("sort_order")
  +Timestamps

  projectStates ProjectChecklistState[]

  @@index([sortOrder])
  @@index([category])
  @@map("checklist_items")
}

model ProjectChecklistState {
  id              String   @id @onCreate(cuid(2))
  projectId       String   @map("project_id")
  checklistItemId String   @map("checklist_item_id")
  checked         Boolean  @default(false)
  scanResultNote  String?  @map("scan_result_note")
  scannedAtLabel  String?  @map("scanned_at_label")
  updatedAt       DateTime @default(now()) @onCreate(now()) @onUpdate(now()) @map("updated_at")

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([projectId, checklistItemId])
  @@map("project_checklist_states")
}

model ScrapeJob {
  id                   String       @id @onCreate(cuid(2))
  projectId            String       @map("project_id")
  contextId            String?      @map("context_id")
  targetType           ContextType  @map("target_type")
  targetValue          String       @map("target_value")
  normalizedUrl        String?      @map("normalized_url")
  status               ScrapeStatus @default(pending)
  httpStatus           Int?         @map("http_status")
  attemptCount         Int          @default(1) @map("attempt_count")
  extractedTitle       String?      @map("extracted_title")
  extractedDescription String?      @map("extracted_description")
  detectedSocials      Json?        @map("detected_socials")
  detectedSignals      String[]     @default(sql`'{}'::text[]`) @map("detected_signals")
  rawPreview           String?      @map("raw_preview")
  errorMessage         String?      @map("error_message")
  durationMs           Int?         @map("duration_ms")
  config               Json?
  providerUsed         String?      @map("provider_used")
  requiresApiKey       Boolean      @default(false) @map("requires_api_key")
  levelsScraped        Int          @default(0) @map("levels_scraped")
  pagesScraped         Int          @default(0) @map("pages_scraped")
  platformData         Json?        @map("platform_data")
  createdAt            DateTime     @default(now()) @onCreate(now()) @map("created_at")
  completedAt          DateTime?    @map("completed_at")

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  context ProjectContext? @relation(fields: [contextId], references: [id], onDelete: SetNull)
  pages   ScrapedPage[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@index([contextId])
  @@map("scrape_jobs")
}

model ScrapedPage {
  id             String   @id @onCreate(cuid(2))
  projectId      String   @map("project_id")
  contextId      String   @map("context_id")
  scrapeJobId    String   @map("scrape_job_id")
  url            String
  canonicalUrl   String?  @map("canonical_url")
  parentUrl      String?  @map("parent_url")
  depth          Int      @default(1)
  httpStatus     Int?     @map("http_status")
  contentType    String?  @map("content_type")
  renderMode     String   @default("playwright_js") @map("render_mode")
  title          String?
  description    String?
  language       String?
  headings       Json?
  textContent    String?  @map("text_content")
  wordCount      Int      @default(0) @map("word_count")
  links          Json?
  socialLinks    Json?    @map("social_links")
  contacts       String[] @default(sql`'{}'::text[]`)
  signals        String[] @default(sql`'{}'::text[]`)
  metaTags       Json?    @map("meta_tags")
  structuredData Json?    @map("structured_data")
  platformData   Json?    @map("platform_data")
  errorMessage   String?  @map("error_message")
  durationMs     Int?     @map("duration_ms")
  scrapedAt      DateTime @default(now()) @onCreate(now()) @map("scraped_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  context   ProjectContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  scrapeJob ScrapeJob      @relation(fields: [scrapeJobId], references: [id], onDelete: Cascade)

  @@index([projectId, scrapedAt])
  @@index([contextId, scrapedAt])
  @@index([scrapeJobId, depth])
  @@map("scraped_pages")
}

model ScraperProviderConfig {
  provider    String   @id
  apiKey      String?  @map("api_key")
  apiSecret   String?  @map("api_secret")
  extraConfig Json?    @map("extra_config")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  updatedBy   String?  @map("updated_by")
  +Timestamps

  @@map("scraper_provider_configs")
}
