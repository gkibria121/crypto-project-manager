# PostgreSQL
POSTGRES_USER=pulseos
POSTGRES_PASSWORD=pulseos_secret
POSTGRES_DB=pulseos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pulseos:pulseos_secret@localhost:5432/pulseos

# NestJS Core Backend (apps/api)
NODE_ENV=development
PORT=4000
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SCRAPER_SERVICE_URL=http://localhost:8001
SCRAPER_API_KEY=pulseos-internal-scraper-key
SCRAPER_TIMEOUT_MS=60000
JWT_SECRET=pulseos-jwt-secret-key-2026-default-secure
SESSION_TTL_SECONDS=604800

# Optional LLM enrichment (falls back to built-in deterministic crypto engine if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Specialized Social Scraper API Keys (required for X, LinkedIn, and Telegram scraping)
X_API_BEARER_TOKEN=
LINKEDIN_API_KEY=
TELEGRAM_BOT_TOKEN=

# Third-Party Crypto Market Cap Sync Providers (free tier API keys)
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
LIVECOINWATCH_API_KEY=
COINCAP_API_KEY=

# Python Scraper Microservice (apps/scraper)
SCRAPER_PORT=8001
SCRAPER_TIMEOUT_SECONDS=12
SCRAPER_MAX_CONTENT_BYTES=2097152
ALLOW_PRIVATE_NETWORKS=false
LOG_LEVEL=INFO

# Next.js Frontend (apps/web)
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:4000
