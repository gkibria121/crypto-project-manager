{
  "name": "crypto-project-manager-monorepo",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "turbo": "^2.11.10",
    "typescript": "^5.8.2"
  },
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "bun --filter @repo/database db:generate",
    "db:migrate": "bun --filter @repo/database db:migrate",
    "db:migrate:deploy": "bun --filter @repo/database db:migrate:deploy",
    "db:push": "bun --filter @repo/database db:push",
    "db:seed": "bun --filter @repo/database db:seed",
    "db:studio": "bun --filter @repo/database db:studio",
    "setup:scraper": "bun --filter @repo/scraper setup",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
